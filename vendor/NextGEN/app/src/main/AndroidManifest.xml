<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Bcore's manifest supplies everything the engine needs: the ~355 stub components, the
      :core / :pN process names, usesCleartextTraffic and the storage/location permissions.
      What is left here is only what the HOST itself uses.

      QUERY_ALL_PACKAGES is kept explicit even though Bcore also declares it: VBridge
      .listInstallable() enumerates device apps from the host process, so the host should not
      inherit that capability by accident from a library manifest.

      Deliberately NOT declared: sharedUserId and an application-level android:process.
      Either one desynchronises BProcessManagerService's process-name matching.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".app.App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NextGen"
        tools:targetApi="n">

        <!--
          Native launcher: GameActivity hosting libloader.so (Rust/egui UI). Replaces the
          BootstrapActivity placeholder. android_main is the entry (winit game-activity glue).
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NextGen.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="loader" />
        </activity>

        <!--
          Clone-and-launch entry for pinned home-screen shortcuts. No UI, hence the translucent
          theme. The FQCN is load-bearing: existing shortcuts hard-reference
          menu.nextgen.launchera.view.main.ShortcutActivity.
        -->
        <activity
            android:name=".view.main.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Container account provisioning. Two of these are referenced BY NAME from the engine
          and must keep their FQCNs:
            ActivityManagerCommonProxy.java:36 -> .view.login.ConsentActivity
            FacebookOAuth.java:39              -> .view.login.WebLoginActivity
        -->
        <activity
            android:name=".view.login.GoogleLoginActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".view.login.WebLoginActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".view.login.ConsentActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
    </application>
</manifest>
