<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      The only theme the host still declares. It is applied at <application> level and used by
      the three login WebView activities; ShortcutActivity overrides it with a translucent one.
      Parent comes from the Material Components library (see app/build.gradle).
    -->
    <style name="Theme.NextGen" parent="Theme.MaterialComponents.Light.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryVariant">@color/primary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
      Splash. The window background is painted before any of our code runs, which covers process
      start plus NextGenCore.doCreate() – the slow part, since it waits on :core coming up.
      BootstrapActivity swaps back to Theme.NextGen in onCreate before super, so this drawable
      never sits behind the real content.
    -->
    <style name="Theme.NextGen.Launch" parent="Theme.NextGen">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

</resources>
